    "el IVA se redondea por linea, no sobre la base total": {
        "lineas": [
            {"cantidad": "1.000", "precio": "2.45", "dto": "0.00", "iva": 21},
            {"cantidad": "1.000", "precio": "2.45", "dto": "0.00", "iva": 21}
        ],
        "esperado": {"base": "4.90", "iva": "1.02", "total": "5.92"}
    },
    "descuento de linea antes del IVA": {
        "lineas": [
            {"cantidad": "1.000", "precio": "100.00", "dto": "15.00", "iva": 21}
        ],
        "esperado": {"base": "85.00", "iva": "17.85", "total": "102.85"}
    },
    "redondeo half up en el medio centimo exacto": {
        "lineas": [
            {"cantidad": "1.000", "precio": "2.50", "dto": "0.00", "iva": 21}
        ],
        "esperado": {"base": "2.50", "iva": "0.53", "total": "3.03"}
    },
    "varios tipos de IVA en la misma factura": {
        "lineas": [
            {"cantidad": "1.000", "precio": "10.00", "dto": "0.00", "iva": 21},
