#!/usr/bin/env bash
# Hook pre-commit: comprueba el formato (Laravel Pint) solo de los ficheros PHP en stage.
# Instalación (una vez por clon): composer hooks:install
# Saltar puntualmente:            SKIP_HOOKS=1 git commit ...
set -euo pipefail

[ "${SKIP_HOOKS:-0}" = "1" ] && exit 0

cd "$(git rev-parse --show-toplevel)"

mapfile -t files < <(git diff --cached --name-only --diff-filter=ACMR -- '*.php')
[ "${#files[@]}" -eq 0 ] && exit 0

if [ ! -x vendor/bin/pint ]; then
    echo "pre-commit: vendor/bin/pint no encontrado (ejecuta composer install). Se omite la comprobación."
    exit 0
fi

if ! vendor/bin/pint --test "${files[@]}"; then
    echo
    echo "✗ Formato incorrecto. Arregla con:"
    echo "    vendor/bin/pint ${files[*]}"
    echo "  y vuelve a hacer git add de los ficheros."
    exit 1
fi
